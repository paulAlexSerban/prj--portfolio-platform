AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
TF_STATE_BUCKET=xxx

# Google Search Console ownership verification token.
# Low sensitivity: not an API key or password. Someone who can publish this
# token in DNS can prove domain ownership to Google. Keep the real value out
# of public source repositories. Terraform publishes it as a TXT record:
# google-site-verification=<token>
TF_VAR_google_site_verification_token=xxx

# Bing Webmaster Tools ownership verification token.
# Low sensitivity: not a credential. Publicly discoverable through DNS.
# Terraform uses it as the CNAME label for apex, blog, news-feed, and www.
# Each of those records points at verify.bing.com.
TF_VAR_bing_site_verification_token=xxx

# DMARC TXT policy for _dmarc.<domain>.
# Public email authentication policy, not a secret.
# p=none is monitoring only: receiving servers are not told to quarantine or
# reject mail that fails DMARC. Quoted because the value contains spaces.
TF_VAR_dmarc_policy="v=DMARC1; p=none"

# AWS Certificate Manager domain-validation CNAMEs.
# Public by design. Not AWS credentials, and not sufficient to access the AWS
# account or issue certificates for unrelated domains. Intended to be published
# in public DNS.
# *_name is the record label, including the leading underscore, without the
# domain. *_target is the acm-validations.aws CNAME value, including the
# trailing dot.

# Apex (first validation record). TTL 500 in Terraform.
TF_VAR_acm_validation_apex_412c69c3_name=xxx
TF_VAR_acm_validation_apex_412c69c3_target=xxx

# Apex (second validation record).
TF_VAR_acm_validation_apex_a6b6bc87_name=xxx
TF_VAR_acm_validation_apex_a6b6bc87_target=xxx

# assets.<domain>
TF_VAR_acm_validation_assets_name=xxx
TF_VAR_acm_validation_assets_target=xxx

# blog.<domain>
TF_VAR_acm_validation_blog_name=xxx
TF_VAR_acm_validation_blog_target=xxx

# news-data.<domain>
TF_VAR_acm_validation_news_data_name=xxx
TF_VAR_acm_validation_news_data_target=xxx

# news-feed.<domain>
TF_VAR_acm_validation_news_feed_name=xxx
TF_VAR_acm_validation_news_feed_target=xxx

# quiz.<domain>
TF_VAR_acm_validation_quiz_name=xxx
TF_VAR_acm_validation_quiz_target=xxx

# www.<domain>
TF_VAR_acm_validation_www_name=xxx
TF_VAR_acm_validation_www_target=xxx
